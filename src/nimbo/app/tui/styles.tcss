Screen {
    background: ansi_default;
    color: ansi_default;
    scrollbar-color: ansi_bright_black;
    scrollbar-color-hover: ansi_bright_black;
    scrollbar-color-active: ansi_bright_black;
    scrollbar-background: ansi_default;
    scrollbar-background-hover: ansi_default;
    scrollbar-background-active: ansi_default;
    scrollbar-size: 1 1;
}

Static, Label {
    color: ansi_default;
}

.muted {
    text-style: dim;
}

#dashboard-body, .panel-body {
    width: 1fr;
    height: 1fr;
    padding: 2 3 1 3;
    overflow-x: hidden;
}

#dashboard-body, #dashboard-footer {
    align-horizontal: center;
}

#dashboard-content, #dashboard-actions {
    max-width: 98;
}

#dashboard-content {
    height: auto;
}

#dashboard-actions {
    height: 1;
}

.short .panel-body {
    padding-top: 1;
}

.narrow .panel-body {
    padding-left: 2;
    padding-right: 2;
}

.short #dashboard-body {
    padding: 1 3 1 3;
}

.narrow #dashboard-body {
    padding: 2 2 1 2;
}

.short.narrow #dashboard-body {
    padding: 1 2 1 2;
}

#dashboard-header, #folder-list, #transfers, .transfer-files {
    height: auto;
}

#identity {
    height: 1;
    margin-bottom: 1;
}

#service-name, #target-label, .folder-name, .transfer-name, .folder-state, .stat-value {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#service-name {
    width: 2fr;
    text-style: bold;
}

#target-label {
    width: 3fr;
    content-align-horizontal: right;
    text-align: right;
    text-style: dim;
}

#primary-bar, #primary-caption, .mini-bar, CountUp {
    height: 1;
}

#primary-caption {
    margin-top: 1;
}

#dashboard-stats, #transfers {
    height: auto;
    margin-top: 2;
}

.short #dashboard-stats, .short #transfers {
    margin-top: 1;
}

.stat {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

.stat-label, .speed-label {
    height: 1;
    text-style: dim;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.stat-value {
    text-style: bold;
}

.mini-bar {
    width: 1fr;
    min-width: 8;
    max-width: 40;
}

.dashboard-rule {
    height: 1;
    margin: 1 0;
}

.folder-row, .transfer-row, .speed-row {
    height: 1;
}

.folder-row {
    margin-bottom: 1;
}

.short .folder-row {
    margin-bottom: 0;
}

.folder-dot {
    width: 2;
    height: 1;
}

.folder-name, .transfer-name {
    width: 36vw;
    max-width: 40;
    margin-right: 2;
}

.transfer-name {
    margin-right: 4;
}

.folder-row .mini-bar, .transfer-row .mini-bar {
    margin-right: 2;
}

.folder-state {
    dock: right;
    width: auto;
    text-align: right;
    content-align-horizontal: right;
}

.transfer-figures {
    dock: right;
    width: 24;
    height: 1;
}

.transfer-percent, .transfer-size {
    text-align: right;
    content-align-horizontal: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.transfer-percent {
    width: 6;
}

.transfer-size {
    width: 1fr;
    margin-left: 1;
    height: 1;
}

.speed-row {
    margin-top: 1;
}

.speed-label {
    width: auto;
    margin-right: 2;
}

.speed-plot {
    width: 24;
}

#recent-backups {
    display: none;
    height: auto;
    margin-top: 3;
}

.roomy #recent-backups.has-runs {
    display: block;
}

.recent-title {
    height: 1;
    text-style: bold;
    margin-bottom: 1;
}

.recent-row, .recent-row Static {
    height: 1;
}

.recent-row {
    margin-bottom: 1;
}

.recent-row Static {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.recent-date {
    width: 25;
}

.recent-result {
    width: 1fr;
}

.recent-files, .recent-size {
    width: 12;
    text-align: right;
    content-align-horizontal: right;
    margin-left: 1;
}

#dashboard-notice, .notice, #pending-status, #history-status {
    height: auto;
    text-style: dim;
    margin-top: 1;
}

#dashboard-footer, .panel-footer {
    dock: bottom;
    width: 1fr;
    height: 2;
    padding: 0 3 1 3;
    background: ansi_default;
}

.narrow #dashboard-footer, .narrow .panel-footer {
    padding-left: 2;
    padding-right: 2;
}

Button.key, Button.flat {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0;
    margin-right: 2;
    background: ansi_default !important;
    color: ansi_default;
    border: none !important;
    tint: transparent !important;
    content-align: left middle;
    text-align: left;
}

Button.key:hover, Button.key:focus, Button.flat:hover, Button.flat:focus {
    text-style: reverse;
}

#nav-quit, #welcome-quit {
    dock: right;
    margin-right: 0;
}

#dashboard-actions Button.key {
    margin-right: 3;
}

Button.key {
    text-style: none;
}

.narrow #dashboard-actions Button.key {
    margin-right: 2;
}

#dashboard-actions #nav-quit {
    margin-right: 0;
}

.narrow #nav-quit {
    dock: none;
}

Button.flat {
    text-style: bold underline;
}

Button.flat:disabled {
    text-style: dim;
    opacity: 1;
}

#review-deletions {
    margin-top: 1;
}

.screen-title, .screen-heading, .screen-intro, .section-heading, .panel-content {
    height: auto;
}

.screen-title, .section-heading {
    text-style: bold;
}

.screen-intro {
    margin-top: 1;
}

.panel-content {
    margin-top: 1;
    margin-bottom: 1;
}

.welcome-title {
    height: auto;
    margin-top: 3;
    text-style: bold;
}

.command-line {
    height: auto;
    margin: 1 0;
    text-style: bold;
}

#pending-filter, .settings-field Input {
    height: 3;
    width: 1fr;
    background: ansi_default;
    color: ansi_default;
    border: tall ansi_bright_black;
}

#pending-filter {
    height: 2;
    max-width: 56;
    margin: 1 0;
    padding: 0;
    border: none;
    border-bottom: solid ansi_bright_black;
}

#pending-filter:focus {
    border-bottom: solid ansi_default;
}

.settings-field Input:focus, #exclusions:focus {
    border: tall ansi_default;
}

Input > .input--placeholder {
    color: ansi_default;
    text-style: dim;
}

Input > .input--cursor, Input > .input--selection {
    background: ansi_default;
    color: ansi_default;
    text-style: reverse;
}

#pending-tree, #history-table {
    height: 1fr;
    background: ansi_default;
    color: ansi_default;
}

Tree > .tree--guides, Tree > .tree--guides-hover, Tree > .tree--guides-selected {
    color: ansi_default;
    text-style: dim;
}

Tree > .tree--cursor, Tree:focus > .tree--cursor, Tree > .tree--highlight-line {
    background: ansi_default;
    color: ansi_default;
    text-style: underline;
}

#history-table {
    margin-top: 1;
}

DataTable > .datatable--header, DataTable > .datatable--header-hover {
    background: ansi_default;
    color: ansi_default;
    text-style: bold dim;
}

DataTable > .datatable--cursor, DataTable:focus > .datatable--cursor,
DataTable > .datatable--hover {
    background: ansi_default;
    color: ansi_default;
    text-style: underline;
}

.settings-form, .settings-folders {
    height: auto;
}

.settings-form, .settings-fields, .settings-form .section-heading {
    margin-top: 1;
}

.settings-folders Checkbox {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: ansi_default;
    color: ansi_default;
    text-overflow: ellipsis;
}

.settings-folders Checkbox > .toggle--button, .settings-folders Checkbox.-on > .toggle--button {
    background: ansi_default;
    color: ansi_default;
}

.settings-folders Checkbox:hover, .settings-folders Checkbox:focus {
    text-style: underline;
}

.settings-fields {
    height: auto;
}

.settings-field {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.settings-field Label {
    width: 1fr;
    height: 2;
    text-style: dim;
}

#exclusions {
    width: 1fr;
    max-width: 70;
    height: 7;
    background: ansi_default;
    color: ansi_default;
    border: tall ansi_bright_black;
}

#exclusions > .text-area--cursor, #exclusions > .text-area--selection {
    background: ansi_default;
    color: ansi_default;
    text-style: reverse;
}

#exclusions > .text-area--cursor-line {
    background: ansi_default;
    color: ansi_default;
}

#settings-status {
    dock: bottom;
    height: auto;
    min-height: 1;
    padding: 0 3;
    text-style: dim;
}

.narrow #settings-status {
    padding: 0 2;
}

.deletion-row {
    height: auto;
    margin-bottom: 1;
}

Toast {
    background: ansi_default;
    color: ansi_default;
    border: tall ansi_bright_black;
}
